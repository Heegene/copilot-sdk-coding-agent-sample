# ============================================================
# GHES Coding Agent - .gitignore
# 보수적(conservative) 설정: secret 노출 방지 최우선
# ============================================================

# ----------------------------------------------------------
# 🔐 SECRETS / CREDENTIALS / TOKENS (최우선 차단)
# ----------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
*.jks
*.keystore
*.secret
*.secrets
*secret*
!*secret*.py
!*secret*.md
*.credential*
*.token
*.tokens
.git-credentials
.netrc
.npmrc
.pypirc
.docker/config.json
gh-token*
copilot-token*
pat-token*
*_TOKEN
*_SECRET
*_KEY
*.env.production
*.env.staging
*.env.development

# GitHub PAT / API keys 파일
token.txt
tokens.txt
api-key*
apikey*
credentials*
!credentials*.py
!credentials*.md
auth.json
secrets.json
secrets.yaml
secrets.yml
.secrets/

# SSH keys
id_rsa*
id_ed25519*
id_ecdsa*
*.pub.key
authorized_keys
known_hosts

# ----------------------------------------------------------
# 🐍 Python
# ----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
*.so
sdist/
wheels/
pip-log.txt
pip-delete-this-directory.txt
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# uv
uv.lock
.uv/

# ----------------------------------------------------------
# 🧪 Testing / Coverage
# ----------------------------------------------------------
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.tox/
.nox/
coverage.xml
*.cover
*.lcov
junit*.xml
test-results/
nosetests.xml

# ----------------------------------------------------------
# 🔎 RAG / Vector Store artifacts
# ----------------------------------------------------------
.vector_store/
*.faiss
*.index
*.pkl
*.pickle
embeddings_cache/

# ----------------------------------------------------------
# 📦 Node.js (Copilot CLI dependency)
# ----------------------------------------------------------
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
.npm/
.yarn/

# ----------------------------------------------------------
# 📝 Logs / Runtime artifacts
# ----------------------------------------------------------
logs/
*.log
*.log.*
copilot-logs/
pr-analysis/
*.artifact
workflow-logs/

# ----------------------------------------------------------
# 🖥️ IDE / Editor
# ----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.orig
*.tmp
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
.history/

# ----------------------------------------------------------
# 💻 OS files
# ----------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ----------------------------------------------------------
# 🔧 Build / Lint cache
# ----------------------------------------------------------
.ruff_cache/
.eslintcache
.stylelintcache

# ----------------------------------------------------------
# 🐳 Docker (if containerized runners)
# ----------------------------------------------------------
.docker/
docker-compose.override.yml
docker-compose.override.yaml

# ----------------------------------------------------------
# ☁️ Cloud / Infra (만약 IaC 추가 시)
# ----------------------------------------------------------
*.tfstate
*.tfstate.backup
.terraform/
*.tfvars
!*.tfvars.example
terraform.tfstate.d/

# ----------------------------------------------------------
# 🤖 Copilot CLI / SDK
# ----------------------------------------------------------
.copilot/
.copilot-session/
copilot-debug/

# ----------------------------------------------------------
# 📋 Temporary / Scratch
# ----------------------------------------------------------
tmp/
temp/
scratch/
*.tmp
*.temp
*.bak
*.backup
*.orig
*.patch
*.diff
